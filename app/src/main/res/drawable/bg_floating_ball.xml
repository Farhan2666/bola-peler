<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer obsidian-teal ring -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:endColor="#060C0C"
                android:startColor="#0F2D2B"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="#2DD4BF" />
        </shape>
    </item>
    <!-- Inner glowing teal core -->
    <item
        android:bottom="11dp"
        android:left="11dp"
        android:right="11dp"
        android:top="11dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:endColor="#0D9488"
                android:startColor="#2DD4BF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
